          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_M8DfKP0D_lU48Ri_Zkariw" name="required_type" type="_wFkAiHOPlb3V4ThmZAl6yg"/>
        </ownedOperation>
        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_EQOWFqxqend0Zgbi_si__A" name="eligible_piles" specification="__l-y_AVNUxtNKhbr5ccEtA">
          <language>Python</language>
          <body>candidates = [p for p in self.piles if p.count &gt; 0 and p.cardType.cost &lt;= max_cost]
if required_type is not None:
    candidates = [p for p in candidates if required_type in p.cardType.types]
return candidates</body>
