        <ownedAttribute xmi:type="uml:Property" xmi:id="_u3ItQ9bEwS9j2fWw5CL9kA" name="players" type="_djIVjnlCztUpPVVgfj8sHQ" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_pmdSUPkxWBrOErlypjHReQ" value="2"/>
