        <ownedRule xmi:type="uml:Constraint" xmi:id="_09OWL1NRweoLW3UVnRJC1Q" name="HasTreasureFacet" constrainedElement="_Fynj5aSoWLHppjotMxbJow">
          <specification xmi:type="uml:OpaqueExpression" xmi:id="_4RYY483mlOJ-2UJK6BabVA">
