        <ownedAttribute xmi:type="uml:Property" xmi:id="_xqb7Y2B28Xzh_UnNhqYBRg" name="count">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="_O1jQtW8edQ3_lkcl7ldbzw" name="Supply">
        <ownedAttribute xmi:type="uml:Property" xmi:id="_HE14stOTNxq1_iQ7HLkTaw" name="piles" type="_DbQhCcuWNPMEvA06MBVNqg" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_QR8t92mEGomiGHFnkju1dg" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_3dQQKvOWn8g8dgcPJdp67g" value="*"/>
        </ownedAttribute>
        <ownedOperation xmi:type="uml:Operation" xmi:id="_B1Yjt1tZcsYYJdByaG1Ktg" name="gain_card_up_to">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_pkV-0Rz8tXoOjgtgg-oRPA" name="max_cost">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          </ownedParameter>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="_q_V-DUuO0GZFNzWg7oEJZQ" name="required_type" type="_wFkAiHOPlb3V4ThmZAl6yg"/>
        </ownedOperation>
        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_bK2v0Ff5nsUJvV8pTQqM8g" name="gain_card_up_to" specification="_B1Yjt1tZcsYYJdByaG1Ktg">
          <language>Python</language>
          <body>candidates = [p for p in self.piles if p.count &gt; 0 and p.cardType.cost &lt;= max_cost]
if required_type is not None:
    candidates = [p for p in candidates if required_type in p.cardType.types]
if not candidates:
    return None
best = max(candidates, key=lambda p: p.cardType.cost)
best.count -= 1
return best.cardType.clone()</body>
