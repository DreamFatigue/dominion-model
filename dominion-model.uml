        <ownedOperation xmi:type="uml:Operation" xmi:id="_Vr8WYrTxYYzTuy9ekYLIhg" name="describe"/>
        <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="__1YmPt-YCeXb65WVnZQ53w" name="describe" specification="_Vr8WYrTxYYzTuy9ekYLIhg">
