        <ownedAttribute xmi:type="uml:Property" xmi:id="_aU_mJ2oWrLb_qP7CF23I0g" name="victoryFacet" type="_v2r_z3vMRwYxbZeNt9ZZew" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_3LPZiiwYMUrKlxQHOya1Fw"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="_Y3il_kajxLeI0dPwUIS0NQ" value="1"/>
