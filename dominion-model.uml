          <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_xNd8IXB25Vdht-5FBLUPIA" name="validate" specification="_IN-hJwAi0m98uI8qRKBlfw">
            <language>Python</language>
            <body>if CardTypeKind.Treasure in self.types:
    assert self.treasureFacet is not None, &quot;Treasure cards must have a treasureFacet&quot;
if CardTypeKind.Victory in self.types or CardTypeKind.Curse in self.types:
    assert self.victoryFacet is not None, &quot;Victory/Curse cards must have a victoryFacet&quot;</body>
          </ownedBehavior>
          <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_UzhXkncHS_4AEAeAnUx0Vg" name="clone" specification="_IMY9R_2oGiTrwnJPOml16A">
            <language>Python</language>
            <body>c = Card()
c.name = self.name
c.cost = self.cost
c.types = list(self.types)
c.treasureFacet.coinValue = self.treasureFacet.coinValue
c.victoryFacet.victoryPoints = self.victoryFacet.victoryPoints
return c</body>
          </ownedBehavior>
